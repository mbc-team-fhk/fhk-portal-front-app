pipeline {
    agent any

    environment {
        APP_NAME        = 'fhk-portal-front-app'
        REGISTRY        = 'juno6800'
        IMAGE           = "${REGISTRY}/${APP_NAME}"
        DOCKERFILE_PATH = 'infra/docker/Dockerfile'
    }

    options {
        timestamps()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'git fetch --tags || true'

                script {
                    // origin/staging, origin/prod 같은 값에서 마지막 토큰만 가져옴
                    def gitBranch = env.GIT_BRANCH ?: ''
                    env.BRANCH_NAME = gitBranch.tokenize('/').last()

                    env.IMAGE_TAG = sh(
                        script: "git describe --tags --exact-match 2>/dev/null || echo NO_TAG",
                        returnStdout: true
                    ).trim()

                    echo "GIT_BRANCH=${gitBranch}, BRANCH_NAME=${env.BRANCH_NAME}"
                }
            }
        }

        stage('Install dependencies') {
            steps {
                sh '''
                  npm ci || npm install
                '''
            }
        }

        stage('Build (Vite)') {
            steps {
                script {
                    env.VITE_BASE_PATH = '/'
                    if (env.IMAGE_TAG == 'NO_TAG') {
                        env.VITE_APP_VERSION = 'dev'
                    } else {
                        env.VITE_APP_VERSION = env.IMAGE_TAG
                    }

                    echo "VITE_APP_VERSION=${env.VITE_APP_VERSION}"
                    echo "VITE_BASE_PATH=${env.VITE_BASE_PATH}"

                    sh '''
                      export VITE_BASE_PATH="${VITE_BASE_PATH}"
                      export VITE_APP_VERSION="${VITE_APP_VERSION}"
                      npm run build
                    '''
                }
            }
        }

        stage('Docker build & push (tagged only)') {
            steps {
                script {
                    echo "Branch: ${env.BRANCH_NAME}, Tag: ${env.IMAGE_TAG}"

                    // 1) dev 브랜치는 무조건 스킵
                    if (env.BRANCH_NAME == 'dev') {
                        echo "dev 브랜치 -> Docker build & push 스킵"
                        return
                    }

                    // 2) 태그가 없으면 스킵 (staging/prod라도)
                    if (env.IMAGE_TAG == 'NO_TAG') {
                        echo "태그 없음 -> Docker build & push 스킵"
                        return
                    }

                    withCredentials([usernamePassword(
                        credentialsId: 'dockerhub-cred',
                        usernameVariable: 'DOCKERHUB_USER',
                        passwordVariable: 'DOCKERHUB_PASS'
                    )]) {
                        sh """
                          echo "$DOCKERHUB_PASS" | docker login -u "$DOCKERHUB_USER" --password-stdin

                          docker build \\
                            -f ${DOCKERFILE_PATH} \\
                            -t ${IMAGE}:${env.IMAGE_TAG} \\
                            -t ${IMAGE}:latest \\
                            .

                          docker push ${IMAGE}:${env.IMAGE_TAG}
                          docker push ${IMAGE}:latest
                        """
                    }
                }
            }
        }

        stage('Deploy to k3s (staging/prod, tagged only)') {
            steps {
                script {
                    echo "Branch: ${env.BRANCH_NAME}, Tag: ${env.IMAGE_TAG}"

                    // dev 브랜치 또는 태그 없는 커밋이면 배포 스킵
                    if (env.BRANCH_NAME == 'dev' || env.IMAGE_TAG == 'NO_TAG') {
                        echo "dev 브랜치이거나 태그 없음 -> 배포 스킵"
                        return
                    }

                    // 브랜치에 따른 namespace / manifest 경로 결정
                    String k8sNamespace
                    String k8sDir

                    if (env.BRANCH_NAME == 'staging') {
                        k8sNamespace = 'staging'
                        k8sDir = 'infra/k3s/staging'
                        // 원하면 여기에서 tag 패턴 체크 (예: -rc 포함 여부)
                        // if (!tag.contains('-rc')) { echo "RC 태그 아님 -> 스킵"; return }
                    } else if (env.BRANCH_NAME == 'prod') {
                        k8sNamespace = 'prod'
                        k8sDir = 'infra/k3s/prod'
                    } else {
                        echo "지원하지 않는 브랜치 -> 배포 스킵"
                        return
                    }

                    // 여기서는 k8s manifest 안의 image를 latest로 두고,
                    // 방금 latest를 새 태그로 덮어쓴다는 전제로 간다.
                    // (원하면 sed로 태그 치환해서 적용하는 방식도 가능)
                    withEnv(["KUBECONFIG=/var/lib/jenkins/.kube/config"]) {
                        sh """
                          kubectl -n ${k8sNamespace} apply -f ${k8sDir}/deployment.yaml
                          kubectl -n ${k8sNamespace} apply -f ${k8sDir}/service.yaml
                          kubectl -n ${k8sNamespace} apply -f ${k8sDir}/ingress.yaml

                          kubectl -n ${k8sNamespace} rollout restart deployment fhk-portal-front-app
                          kubectl -n ${k8sNamespace} rollout status deployment fhk-portal-front-app --timeout=120s
                        """
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
